# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

# ── Supabase ───────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — ONLY used in server-side code, never exposed to the browser.
# Required for client invites (src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Site URL ───────────────────────────────────────────────────────────────────
# Where auth emails send people back to. Must be the real deployed origin in
# production — invite and password-reset links are built from this, so if it is
# wrong or missing, invited clients get links pointing at localhost.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Resend ─────────────────────────────────────────────────────────────────────
# Transactional email: approval notifications and @mention emails.
# Without RESEND_API_KEY those sends are skipped with a console warning —
# the app still works, the emails just never arrive.
#
# NOTE: Supabase's own auth emails (invite, magic link, password reset) do NOT
# use these vars. They go through Supabase Auth → SMTP Settings, which should
# also be pointed at Resend.

RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM=Weblikha Portal <onboarding@resend.dev>
